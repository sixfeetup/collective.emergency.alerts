<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
      i18n:domain="plone"
>
  <body>


    <metal:block fill-slot="javascript_head_slot">

      <script type="text/javascript">
            $(document).ready(function(){

            });
      </script>

    </metal:block>

    <metal:content-title fill-slot="content-title">
      <h1 class="documentFirstHeading"
          tal:on-error="nothing"
      >
            Editing Alert:
        <tal:block replace="python: view.alert.get('title')" />
      </h1>
    </metal:content-title>

    <metal:content fill-slot="content-core">


      <div class="eas-error"
           tal:condition="view/error"
      >
            No alert was found with this id
      </div>

      <form class="rowlike enableUnloadProtection kssattr-formname-edit"
            id="form"
            action="${view/portal/absolute_url}/edit_alert"
            enctype="multipart/form-data"
            method="post"
            tal:condition="not: view/error"
      >

        <div class="field pat-inlinevalidation kssattr-fieldname-form.widgets.title"
             id="formfield-form-widgets-title"
             data-fieldname="form.widgets.title"
             data-pat-inlinevalidation="{&quot;type&quot;:&quot;z3c.form&quot;}"
        >
          <label class="horizontal"
                 for="form-widgets-title"
          >
                Alert Title
            <span class="required horizontal"
                  title="Required"
            >&nbsp;</span>
          </label>
          <div class="fieldErrorBox"></div>
          <input class="text-widget required textline-field"
                 id="form-widgets-title"
                 name="form.widgets.title"
                 type="text"
                 tal:attributes="
                   value python: view.alert.get('title');
                 "
          />
        </div>

        <div class="field pat-inlinevalidation kssattr-fieldname-form.widgets.body"
             id="formfield-form-widgets-body"
             data-fieldname="form.widgets.body"
             data-pat-inlinevalidation="{&quot;type&quot;:&quot;z3c.form&quot;}"
        >
          <label class="horizontal"
                 for="form-widgets-body"
          >
                Alert Details
            <span class="required horizontal"
                  title="Required"
            >&nbsp;</span>
          </label>
          <div class="fieldErrorBox"></div>
          <textarea class="pat-tinymce"
                    id="form-widgets-body"
                    name="form.widgets.body"
                    type="text"
                    data-pat-tinymce='{"relatedItems": {"vocabularyUrl": "/relateditems-test.json" },
                           {"upload": {"baseUrl": "/", relativePath: "upload"} } }'
                    tal:content="python: view.alert.get('body')"
          >
          </textarea>
        </div>

        <div class="field pat-inlinevalidation kssattr-fieldname-form.widgets.level"
             id="formfield-form-widgets-level"
             data-fieldname="form.widgets.level"
             data-pat-inlinevalidation="{&quot;type&quot;:&quot;z3c.form&quot;}"
        >
          <label class="horizontal"
                 for="form-widgets-level"
          >
                Alert level:
            <span class="required horizontal"
                  title="Required"
            >&nbsp;</span>
          </label>
          <div class="fieldErrorBox"></div>
          <select id="form-widgets-level"
                  name="form.widgets.level"
          >
            <option class="eas-lvl-0"
                    value="0"
                    tal:attributes="
                      selected python: view.alert.get('level') == '0' and 'selected';
                    "
            >Alert</option>
            <option class="eas-lvl-1"
                    value="1"
                    tal:attributes="
                      selected python: view.alert.get('level') == '1' and 'selected';
                    "
            >Weather Alert</option>
          </select>
        </div>

        <div class="field pat-inlinevalidation kssattr-fieldname-form.widgets.start"
             id="formfield-form-widgets-start"
             data-fieldname="form.widgets.start"
             data-pat-inlinevalidation="{&quot;type&quot;:&quot;z3c.form&quot;}"
        >
          <label class="horizontal"
                 for="form-widgets-start"
          >
                Alert start date: (leave empty for immediate alert)
            <span class="required horizontal"
                  title="Required"
            >&nbsp;</span>
          </label>
          <div class="fieldErrorBox"></div>
          <input id="form-widgets-start"
                 name="form.widgets.start"
                 type="datetime-local"
                 tal:attributes="
                   value python: view.alert.get('start');
                 "
          />
        </div>

        <div class="field pat-inlinevalidation kssattr-fieldname-form.widgets.end"
             id="formfield-form-widgets-end"
             data-fieldname="form.widgets.end"
             data-pat-inlinevalidation="{&quot;type&quot;:&quot;z3c.form&quot;}"
        >
          <label class="horizontal"
                 for="form-widgets-end"
          >
                Alert end date: (leave empty for immediate alert)
            <span class="required horizontal"
                  title="Required"
            >&nbsp;</span>
          </label>
          <div class="fieldErrorBox"></div>
          <input id="form-widgets-end"
                 name="form.widgets.end"
                 type="datetime-local"
                 tal:attributes="
                   value python: view.alert.get('end');
                 "
          />
        </div>

        <div class="field pat-inlinevalidation kssattr-fieldname-form.widgets.active"
             id="formfield-form-widgets-active"
             data-fieldname="form.widgets.active"
             data-pat-inlinevalidation="{&quot;type&quot;:&quot;z3c.form&quot;}"
        >
          <label class="horizontal"
                 for="form-widgets-active"
          >
                Activate Alert?
            <span class="required horizontal"
                  title="Required"
            >&nbsp;</span>
          </label>
          <div class="fieldErrorBox"></div>
          <input id="form-widgets-active"
                 name="form.widgets.active"
                 type="checkbox"
                 tal:attributes="
                   checked python: view.alert.get('is_active')=='True';
                 "
          />
        </div>

        <input name="id"
               type="hidden"
               tal:attributes="
                 value python: view.alert.id;
               "
        />
        <input class="context"
               name="form.widgets.submit"
               type="submit"
               value="Save"
        />
        <a class="standalone"
           href="${view/portal/absolute_url}/@@emergency_manager"
        >Cancel</a>

      </form>

    </metal:content>

  </body>
</html>
